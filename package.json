{
  "name": "lootdive",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest",
    "test:run": "vitest run",
    "simulation": "TSX_TSCONFIG_PATH=tsconfig.scripts.json tsx scripts/runSimulation.ts",
    "simulation:uber": "TSX_TSCONFIG_PATH=tsconfig.scripts.json tsx scripts/runUberBossSimulation.ts",
    "analyze:bundle": "echo '\n📊 バンドルサイズを分析します...\n' && rm -rf dist && npx expo export --platform ios && echo '\n📈 分析結果:\n' && echo '----------------------------------------' && du -sh dist && echo '----------------------------------------' && echo 'JSバンドル:' && find dist/_expo/static/js -name '*.js' -exec du -h {} \\; && echo '----------------------------------------' && echo 'アセット:' && du -sh dist/assets && echo '\n💡 詳細な分析が必要な場合は、Expo Dev Toolsのプロファイラーを使用してください。'"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/analytics": "^23.8.6",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/crashlytics": "^23.8.6",
    "@react-native-firebase/firestore": "^23.8.6",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.30",
    "expo-application": "^7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-localization": "^17.0.8",
    "expo-router": "~6.0.21",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^25.7.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.3",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.0.3",
    "react-native-purchases": "^9.7.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-atlas": "^0.4.0",
    "react-native-bundle-visualizer": "^3.1.3",
    "source-map-explorer": "^2.5.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^2.1.8"
  },
  "private": true
}
